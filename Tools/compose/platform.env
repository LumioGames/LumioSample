# This game's Platform inputs for the engine release compose (Engine/platform/docker-compose.yml,
# ADR-123 决策 8). The compose file itself is game-agnostic; everything that names "sample" is here.
# Local development only: the loopback ws:// allocation below is accepted only under the
# release compose's `test` registration profile.
#
# Trusted static allocation for slug `sample`. The launcher points bots at the DS it started
# (DS_READY endpoint) and copies these six claims into that DS's run config from the launch
# response, so WsUrl here is informational. NotAfter is 2100-01-01.
Platform__Allocations__sample__AllocationId=alloc-sample-1
Platform__Allocations__sample__WsUrl=ws://127.0.0.1:9110/sample
Platform__Allocations__sample__Subprotocol=lumio.mvp.v0
Platform__Allocations__sample__ServerAudience=game-fleet-local
Platform__Allocations__sample__GameId=sample
Platform__Allocations__sample__GameReleaseId=sample-0.1.0
Platform__Allocations__sample__ContractId=lumio.gameplay-envelope.v1
Platform__Allocations__sample__RoomId=room-sample-1
Platform__Allocations__sample__NotAfter=4102444800
Platform__Allocations__sample__LocalTest=true
