<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Spectator dump / replica-host tests. Not in LumioSample.slnx. Compiles the two
    game-side sources one level up against the engine parts of the Engine/ release: the
    netstandard2.1 browser replica, including Lumio.Client.Spectator.dll with the two C#
    engine parts ($(LumioSpectatorReplicaDir), see ../Directory.Build.props). CI builds this
    project as the compile guard between this game and the pinned engine (test job in ci.yml).
    LumioEcsGenerate=false: the SDK package enables generation for every consumer, and
    this assembly declares no entities.
  -->
  <PropertyGroup>
    <LumioProduction>false</LumioProduction>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lumio.Sample.Client.Spectator.Tests</RootNamespace>
    <LumioEcsGenerate>false</LumioEcsGenerate>
    <AssemblyName>Lumio.Sample.Client.Spectator.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../SpectatorDump.cs" Link="Spectator/SpectatorDump.cs" />
    <Compile Include="../SpectatorReplicaHost.cs" Link="Spectator/SpectatorReplicaHost.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <!-- ADR-123: the engine is the Engine/ release — the Runtime through Lumio.Engine.SDK
         (Engine/sdk, NuGet.config source mapping) and the netstandard2.1 Replica from
         web/replica/. The gameplay is this repository's own. -->
    <PackageReference Include="Lumio.Engine.SDK" Version="$(LumioSdkVersion)" />
    <Reference Include="Lumio.Client.Gameplay.ECS" HintPath="$(LumioSpectatorReplicaDir)Lumio.Client.Gameplay.ECS.dll" />
    <Reference Include="Lumio.Client.Log" HintPath="$(LumioSpectatorReplicaDir)Lumio.Client.Log.dll" />
    <Reference Include="Lumio.Client.Spectator" HintPath="$(LumioSpectatorReplicaDir)Lumio.Client.Spectator.dll" />
    <ProjectReference Include="$(LumioSampleRepoRoot)Gameplay/Lumio.Sample.Gameplay.csproj">
      <Properties>LumioEcsSide=client</Properties>
    </ProjectReference>
  </ItemGroup>
</Project>
