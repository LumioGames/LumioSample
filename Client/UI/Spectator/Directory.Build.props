<Project>
  <!--
    Spectator page + its C# wasm host and tests. MSBuild stops walking after this file,
    so the repo-root analyzers / central package management do not apply here (the
    shared sources below were written against the settings in this file).
    None of these projects are in LumioSample.slnx.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <LangVersion>14.0</LangVersion>
    <LumioSpectatorRoot>$(MSBuildThisFileDirectory)</LumioSpectatorRoot>
    <LumioSampleRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../'))</LumioSampleRepoRoot>
    <LumioRuntimeRoot Condition="'$(LumioRuntimeRoot)' == '' AND '$(LUMIO_RUNTIME_ROOT)' != ''">$(LUMIO_RUNTIME_ROOT)</LumioRuntimeRoot>
    <LumioRuntimeRoot Condition="'$(LumioRuntimeRoot)' == '' AND Exists('$(LumioSampleRepoRoot)../LumioGameRuntime')">$([System.IO.Path]::GetFullPath('$(LumioSampleRepoRoot)../LumioGameRuntime'))</LumioRuntimeRoot>
    <!--
      LumioClient checkout that ships the engine parts this page is assembled from
      (R-00710): connect-ds / voxel-grid / generated close-code and not_serving tables /
      dev hot-reload bridge (JS), SpectatorSectionFrame and ReplicaApplyTickLoop (C#),
      and the netstandard2.1 Replica the wasm host references. They are taken from
      that checkout at build and publish time and never copied into this repository.
      LUMIO_CLIENT_ROOT when set, else the sibling checkout; missing is BLOCKED.
    -->
    <LumioClientRoot Condition="'$(LumioClientRoot)' == '' AND '$(LUMIO_CLIENT_ROOT)' != ''">$(LUMIO_CLIENT_ROOT)</LumioClientRoot>
    <LumioClientRoot Condition="'$(LumioClientRoot)' == '' AND Exists('$(LumioSampleRepoRoot)../LumioClient')">$([System.IO.Path]::GetFullPath('$(LumioSampleRepoRoot)../LumioClient'))</LumioClientRoot>
    <LumioClientSpectatorParts Condition="'$(LumioClientRoot)' != ''">$(LumioClientRoot)/Client/UI/Spectator/</LumioClientSpectatorParts>
    <!-- VoxelEngine checkout the browser voxel .wasm is built from (ADR-078 决策 1:
         the page runs that repo's own Rust, never a JS re-implementation). -->
    <LumioVoxelRoot Condition="'$(LumioVoxelRoot)' == '' AND '$(LUMIO_VOXEL_ROOT)' != ''">$(LUMIO_VOXEL_ROOT)</LumioVoxelRoot>
    <LumioVoxelRoot Condition="'$(LumioVoxelRoot)' == '' AND Exists('$(LumioSampleRepoRoot)../LumioVoxelEngine')">$([System.IO.Path]::GetFullPath('$(LumioSampleRepoRoot)../LumioVoxelEngine'))</LumioVoxelRoot>
    <LumioVoxelWasm Condition="'$(LumioVoxelWasm)' == '' AND '$(LumioVoxelRoot)' != ''">$(LumioVoxelRoot)/target/wasm32-unknown-unknown/release/lumio_voxel_wasm.wasm</LumioVoxelWasm>
  </PropertyGroup>
  <!--
    This game's own LumioConfig client export, embedded beside the shared spectator
    sources. The Sample client registry declares a gameplay config contract, so
    WorldManager refuses to build a world without the projected tables. Browser wasm
    has no host filesystem, so the export cannot be resolved by directory there; both
    C# projects here compile the same SpectatorDump.cs, so both carry it. Layout
    matches the export the Sample assembly itself copies: root manifest plus the
    client projection.
  -->
  <ItemGroup>
    <EmbeddedResource Include="$(LumioSampleRepoRoot)Client/Config/Tables/manifest.json" LogicalName="SampleConfigExport/manifest.json" />
    <EmbeddedResource Include="$(LumioSampleRepoRoot)Client/Config/Tables/client/*.json" LogicalName="SampleConfigExport/client/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
