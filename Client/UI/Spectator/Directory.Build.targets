<Project>
  <!-- Also stops repo-root Directory.Build.targets (sibling SDK resolution for the gameplay
       projects) from reaching the wasm host and its tests. -->
  <Target Name="EnsureSpectatorInputs" BeforeTargets="Restore;CollectPackageReferences;PrepareForBuild">
    <Error Condition="'$(LumioRuntimeRoot)' == '' OR !Exists('$(LumioRuntimeRoot)/modules/ecs/src/Lumio.GameRuntime.Ecs/Lumio.GameRuntime.Ecs.csproj')" Text="BLOCKED: LumioRuntimeRoot is not set and sibling LumioGameRuntime was not found (set LUMIO_RUNTIME_ROOT)." />
    <!-- The engine parts come from LumioClient; there is no local copy to fall back to. -->
    <Error Condition="'$(LumioClientRoot)' == '' OR !Exists('$(LumioClientSpectatorParts)connect-ds.mjs') OR !Exists('$(LumioClientSpectatorParts)tests/SpectatorSectionFrame.cs')" Text="BLOCKED: LumioClientRoot is not set and sibling LumioClient was not found (set LUMIO_CLIENT_ROOT). Expected engine parts under $(LumioClientSpectatorParts)." />
    <!-- Fail closed rather than compile a spectator that cannot project this game's config tables. -->
    <Error Condition="!Exists('$(LumioSampleRepoRoot)Client/Config/Tables/client/manifest.json')" Text="BLOCKED: this game's client config export is missing: $(LumioSampleRepoRoot)Client/Config/Tables/client/manifest.json" />
  </Target>
</Project>
