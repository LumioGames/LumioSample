<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 玩法程序集两端共用:服务器 net10.0,客户端 netstandard2.1(Unity / HybridCLR) -->
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <AssemblyName>Lumio.Sample.Gameplay</AssemblyName>
    <RootNamespace>Lumio.Sample.Gameplay</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CA1510: ArgumentNullException.ThrowIfNull 在 netstandard2.1 上不存在 -->
    <NoWarn>$(NoWarn);CA1510</NoWarn>
  </PropertyGroup>
  <!--
    本工程刻意不引用任何 Lumio 引擎程序集。
    引擎依赖的解析方式由 S-2(SDK 打包)确定;在那之前只放不依赖引擎的玩法逻辑,
    以保证「clone 即编译」从第一天起就成立。禁止 ProjectReference 到任何私有仓源码路径。
  -->
</Project>
