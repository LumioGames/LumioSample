<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Spectator wasm cannot consume the net10.0 Runtime graph: that TFM
         ProjectReferences NativeLoader, and NuGet unifies the whole wasm
         restore onto net10.0 even when inner Runtime refs ask for ns2.1. -->
    <TargetFramework Condition="'$(LumioBrowserReplica)' == 'true'">netstandard2.1</TargetFramework>
    <TargetFramework Condition="'$(LumioBrowserReplica)' != 'true'">net10.0</TargetFramework>
    <AssemblyName>Lumio.Sample.Gameplay</AssemblyName>
    <RootNamespace>Lumio.Sample.Gameplay</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <_LumioConfigSide Condition="'$(LumioEcsSide)' == 'client'">client</_LumioConfigSide>
    <_LumioConfigSide Condition="'$(_LumioConfigSide)' == ''">server</_LumioConfigSide>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep manifest identity intact; the Runtime loader reads only the selected projection. -->
    <None Include="../../config/manifest.json" Link="config/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../config/$(_LumioConfigSide)/**/*" Link="config/$(_LumioConfigSide)/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' == 'netstandard2.1'" />
  </ItemGroup>
</Project>
