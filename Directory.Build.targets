<Project>
  <!-- Resolve the engine through exactly one of the supported public paths. -->
  <PropertyGroup>
    <LumioRuntimeRoot Condition="'$(LumioRuntimeRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../LumioGameRuntime')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../LumioGameRuntime'))</LumioRuntimeRoot>
    <_LumioRuntimeRootRaw Condition="'$(LumioRuntimeRoot)' != ''">$(LumioRuntimeRoot.Trim())</_LumioRuntimeRootRaw>
    <_LumioRuntimeRoot Condition="'$(_LumioRuntimeRootRaw)' != ''">$([System.IO.Path]::GetFullPath('$(_LumioRuntimeRootRaw)'))</_LumioRuntimeRoot>
    <_LumioLocalFeedRaw Condition="'$(LumioLocalFeed)' != ''">$(LumioLocalFeed.Trim())</_LumioLocalFeedRaw>
    <_LumioLocalFeed Condition="'$(_LumioLocalFeedRaw)' != ''">$([System.IO.Path]::GetFullPath('$(_LumioLocalFeedRaw)'))</_LumioLocalFeed>
    <_LumioRuntimeEcsProject>$(_LumioRuntimeRoot)/modules/ecs/src/Lumio.GameRuntime.Ecs/Lumio.GameRuntime.Ecs.csproj</_LumioRuntimeEcsProject>
    <_LumioRuntimeReplicationProject>$(_LumioRuntimeRoot)/modules/replication/src/Lumio.GameRuntime.Replication/Lumio.GameRuntime.Replication.csproj</_LumioRuntimeReplicationProject>
    <_LumioRuntimeGasProject>$(_LumioRuntimeRoot)/modules/gas/src/Lumio.GameRuntime.Gas/Lumio.GameRuntime.Gas.csproj</_LumioRuntimeGasProject>
    <_LumioRuntimeConfigProject>$(_LumioRuntimeRoot)/modules/config/src/Lumio.GameRuntime.Config/Lumio.GameRuntime.Config.csproj</_LumioRuntimeConfigProject>
    <_LumioRuntimeSimulationProject>$(_LumioRuntimeRoot)/modules/simulation/src/Lumio.GameRuntime.Simulation/Lumio.GameRuntime.Simulation.csproj</_LumioRuntimeSimulationProject>
    <_LumioRuntimeGenProps>$(_LumioRuntimeRoot)/tools/gen-declarations/build/Lumio.Tools.GenDeclarations.props</_LumioRuntimeGenProps>
    <_LumioRuntimeExists Condition="'$(_LumioRuntimeRoot)' != '' and Exists('$(_LumioRuntimeRoot)') and Exists('$(_LumioRuntimeEcsProject)') and Exists('$(_LumioRuntimeReplicationProject)') and Exists('$(_LumioRuntimeGasProject)') and Exists('$(_LumioRuntimeConfigProject)') and Exists('$(_LumioRuntimeSimulationProject)')">true</_LumioRuntimeExists>
    <_LumioRuntimeInvalid Condition="'$(_LumioRuntimeRoot)' != '' and '$(_LumioRuntimeExists)' != 'true'">true</_LumioRuntimeInvalid>
    <_LumioNugetPackages Condition="'$(NuGetPackageRoot)' != ''">$(NuGetPackageRoot)</_LumioNugetPackages>
    <_LumioNugetPackages Condition="'$(_LumioNugetPackages)' == '' and '$(NUGET_PACKAGES)' != ''">$(NUGET_PACKAGES)</_LumioNugetPackages>
    <_LumioNugetPackages Condition="'$(_LumioNugetPackages)' == '' and '$(USERPROFILE)' != ''">$(USERPROFILE)/.nuget/packages</_LumioNugetPackages>
    <_LumioNugetPackages Condition="'$(_LumioNugetPackages)' == '' and '$(HOME)' != ''">$(HOME)/.nuget/packages</_LumioNugetPackages>
    <_LumioNupkg Condition="'$(_LumioLocalFeed)' != '' and Exists('$(_LumioLocalFeed)/Lumio.Engine.SDK.$(LumioSdkVersion).nupkg')">true</_LumioNupkg>
    <_LumioNupkg Condition="'$(_LumioNupkg)' != 'true' and '$(_LumioLocalFeed)' != '' and Exists('$(_LumioLocalFeed)/lumio.engine.sdk.$(LumioSdkVersion).nupkg')">true</_LumioNupkg>
    <_LumioGlobalPackage Condition="'$(_LumioNugetPackages)' != '' and Exists('$(_LumioNugetPackages)/lumio.engine.sdk/$(LumioSdkVersion)/lumio.engine.sdk.nuspec')">true</_LumioGlobalPackage>
    <LumioSdkMode Condition="'$(_LumioRuntimeExists)' == 'true'">sibling</LumioSdkMode>
    <LumioSdkMode Condition="'$(LumioSdkMode)' == '' and '$(_LumioRuntimeInvalid)' != 'true' and ('$(_LumioNupkg)' == 'true' or '$(_LumioGlobalPackage)' == 'true')">nuget</LumioSdkMode>
  </PropertyGroup>

  <!-- HostEntry loads Lumio.GameRuntime.Simulation.dll beside the assemblies
       server.json names and reflects DedicatedServerHostBinding.TryAttach.
       The consumer is net10.0; Simulation's ns2.1 TFM Compile-Removes that type.
       Spectator wasm passes LumioBrowserReplica=true so NativeLoader stays out. -->
  <PropertyGroup>
    <_LumioRuntimeTfm Condition="'$(LumioBrowserReplica)' == 'true'">netstandard2.1</_LumioRuntimeTfm>
    <_LumioRuntimeTfm Condition="'$(_LumioRuntimeTfm)' == ''">net10.0</_LumioRuntimeTfm>
  </PropertyGroup>
  <ItemGroup Condition="'$(LumioSdkMode)' == 'sibling' and ('$(MSBuildProjectName)' == 'Lumio.Sample.Gameplay' or '$(MSBuildProjectName)' == 'Lumio.Sample.Gameplay.Tests')">
    <ProjectReference Include="$(_LumioRuntimeEcsProject)">
      <SetTargetFramework Condition="'$(LumioBrowserReplica)' == 'true'">TargetFramework=netstandard2.1</SetTargetFramework>
    </ProjectReference>
    <ProjectReference Include="$(_LumioRuntimeReplicationProject)">
      <SetTargetFramework Condition="'$(LumioBrowserReplica)' == 'true'">TargetFramework=netstandard2.1</SetTargetFramework>
    </ProjectReference>
    <ProjectReference Include="$(_LumioRuntimeGasProject)">
      <SetTargetFramework Condition="'$(LumioBrowserReplica)' == 'true'">TargetFramework=netstandard2.1</SetTargetFramework>
    </ProjectReference>
    <ProjectReference Include="$(_LumioRuntimeConfigProject)">
      <SetTargetFramework Condition="'$(LumioBrowserReplica)' == 'true'">TargetFramework=netstandard2.1</SetTargetFramework>
    </ProjectReference>
    <ProjectReference Include="$(_LumioRuntimeSimulationProject)">
      <SetTargetFramework>TargetFramework=$(_LumioRuntimeTfm)</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <!-- Sibling never imports the SDK nupkg props. Those defaults (generate on, exclude generated/**)
       have to come from the Runtime checkout or the first entity day fails with CS8795. -->
  <Import
    Project="$(_LumioRuntimeGenProps)"
    Condition="'$(LumioSdkMode)' == 'sibling' and '$(MSBuildProjectName)' == 'Lumio.Sample.Gameplay' and Exists('$(_LumioRuntimeGenProps)')" />

  <!-- TreatWarningsAsErrors + GenerateDocumentationFile still elevates CS1591 on some
       SDK hosts even when the gameplay csproj already lists it in NoWarn. Restate both
       here (after the sibling import) so generated files stay machine-written. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Lumio.Sample.Gameplay'">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Lumio.Sample.Gameplay'">
    <!-- ADR-115: the typed Readers live under each end's Config/Generated. They are
         compiled into this assembly's matching side; the gameplay tree has no
         generated/config/ any more, so only the selected end's Readers can enter. -->
    <Compile Remove="generated/config/**/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Client/Config/Generated/*.cs" Link="config/generated/%(Filename)%(Extension)" Condition="'$(_LumioConfigSide)' == 'client'" />
    <Compile Include="$(MSBuildThisFileDirectory)Server/Config/Generated/*.cs" Link="config/generated/%(Filename)%(Extension)" Condition="'$(_LumioConfigSide)' != 'client'" />
  </ItemGroup>

  <!-- Same analyzer exemptions the SDK pack props apply when the generator is on.
       They live here only because sibling cannot see the nupkg. Do not copy them into the gameplay csproj. -->
  <PropertyGroup Condition="'$(LumioSdkMode)' == 'sibling' and '$(MSBuildProjectName)' == 'Lumio.Sample.Gameplay' and '$(LumioEcsGenerate)' == 'true'">
    <NoWarn>$(NoWarn);CA1051;CA1711;CA1707;CA1034;CA1822;CA1848;CA1873</NoWarn>
  </PropertyGroup>

  <!-- One gameplay tree, two compile sides. Server is the default (DS loads this assembly). -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Lumio.Sample.Gameplay' and '$(LumioEcsSide)' != 'client'">
    <DefineConstants>$(DefineConstants);LUMIO_SERVER</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Lumio.Sample.Gameplay' and '$(LumioEcsSide)' != 'client'">
    <Compile Remove="**/*.Client.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Lumio.Sample.Gameplay' and '$(LumioEcsSide)' == 'client'">
    <DefineConstants>$(DefineConstants);LUMIO_CLIENT</DefineConstants>
    <!-- OutputPath isolation lives in Directory.Build.props (evaluated before the SDK). -->
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Lumio.Sample.Gameplay' and '$(LumioEcsSide)' == 'client'">
    <Compile Remove="**/*.Server.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(LumioSdkMode)' == 'nuget' and '$(_LumioNupkg)' == 'true'">
    <RestoreAdditionalProjectSources>$(_LumioLocalFeed);$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup Condition="'$(LumioSdkMode)' == 'nuget' and ('$(MSBuildProjectName)' == 'Lumio.Sample.Gameplay' or '$(MSBuildProjectName)' == 'Lumio.Sample.Gameplay.Tests')">
    <PackageReference Include="Lumio.Engine.SDK" />
  </ItemGroup>

  <!-- Packed SDK props default LumioEcsGenerate=true for every consumer. The test
       project has no entity declarations; generating there emits typeof(WorldEntity)
       without the type (CS0246 on external-clone). -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Lumio.Sample.Gameplay.Tests'">
    <LumioEcsGenerate>false</LumioEcsGenerate>
  </PropertyGroup>

  <!-- Sibling has no packed gen-declarations task. Build the Runtime tool and invoke it the
       same way the SDK targets do (dotnet exec + Include). This is not a fourth resolve path. -->
  <ItemGroup Condition="'$(LumioSdkMode)' == 'sibling' and '$(MSBuildProjectName)' == 'Lumio.Sample.Gameplay' and '$(LumioEcsGenerate)' == 'true'">
    <!-- Restore and build the tool with this consumer's SDK roots and output settings. -->
    <ProjectReference Include="$(_LumioRuntimeRoot)/tools/gen-declarations/Lumio.Tools.GenDeclarations.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="TargetFramework;TargetFrameworks" />
  </ItemGroup>
  <Target
    Name="LumioSiblingGenerateDeclarations"
    BeforeTargets="BeforeCompile"
    Condition="'$(LumioSdkMode)' == 'sibling' and '$(MSBuildProjectName)' == 'Lumio.Sample.Gameplay' and '$(LumioEcsGenerate)' == 'true'">
    <PropertyGroup>
      <_LumioEcsToolProject>$(_LumioRuntimeRoot)/tools/gen-declarations/Lumio.Tools.GenDeclarations.csproj</_LumioEcsToolProject>
      <_LumioEcsSide Condition="'$(_LumioEcsSide)' == ''">$(LumioEcsSide)</_LumioEcsSide>
      <_LumioEcsSide Condition="'$(_LumioEcsSide)' == ''">server</_LumioEcsSide>
      <_LumioEcsSources Condition="'$(_LumioEcsSources)' == ''">$(MSBuildProjectDirectory)</_LumioEcsSources>
      <_LumioEcsOut>$(MSBuildProjectDirectory)/generated/$(_LumioEcsSide)</_LumioEcsOut>
      <_LumioEcsJson>$(_LumioEcsOut)/attribute-declarations.json</_LumioEcsJson>
      <_LumioEcsStamp>$(_LumioEcsOut)/gen.hash</_LumioEcsStamp>
      <_LumioEcsNamespace Condition="'$(RootNamespace)' != ''">$(RootNamespace)</_LumioEcsNamespace>
      <_LumioEcsNamespace Condition="'$(_LumioEcsNamespace)' == ''">$(MSBuildProjectName)</_LumioEcsNamespace>
      <_LumioGameplayConfigArgs Condition="'$(LumioGameplayConfigContract)' != '' or '$(LumioGameplayConfigAdapter)' != ''">--gameplay-config-contract &quot;$(LumioGameplayConfigContract)&quot; --gameplay-config-adapter &quot;$(LumioGameplayConfigAdapter)&quot;</_LumioGameplayConfigArgs>
    </PropertyGroup>
    <Error Condition="!Exists('$(_LumioEcsToolProject)')" Text="LUMIO_SDK_UNRESOLVED: sibling Runtime is missing tools/gen-declarations." />
    <MakeDir Directories="$(_LumioEcsOut)" />
    <MSBuild Projects="$(_LumioEcsToolProject)" Targets="Build"
             RemoveProperties="TargetFramework;TargetFrameworks" BuildInParallel="false" />
    <MSBuild Projects="$(_LumioEcsToolProject)" Targets="GetTargetPath"
             RemoveProperties="TargetFramework;TargetFrameworks" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" PropertyName="_LumioEcsToolDll" />
    </MSBuild>
    <Exec Command="dotnet exec &quot;$(_LumioEcsToolDll)&quot; --sources &quot;$(_LumioEcsSources)&quot; --side $(_LumioEcsSide) --output-dir &quot;$(_LumioEcsOut)&quot; --output &quot;$(_LumioEcsJson)&quot; --assembly-name &quot;$(AssemblyName)&quot; --namespace &quot;$(_LumioEcsNamespace)&quot; $(_LumioGameplayConfigArgs) --hash" ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_LumioEcsInputHash" />
    </Exec>
    <PropertyGroup>
      <_LumioEcsPreviousHash Condition="Exists('$(_LumioEcsStamp)')">$([System.IO.File]::ReadAllText('$(_LumioEcsStamp)').Trim())</_LumioEcsPreviousHash>
    </PropertyGroup>
    <Exec Condition="'$(_LumioEcsInputHash)' != '$(_LumioEcsPreviousHash)'" Command="dotnet exec &quot;$(_LumioEcsToolDll)&quot; --sources &quot;$(_LumioEcsSources)&quot; --side $(_LumioEcsSide) --output-dir &quot;$(_LumioEcsOut)&quot; --output &quot;$(_LumioEcsJson)&quot; --assembly-name &quot;$(AssemblyName)&quot; --namespace &quot;$(_LumioEcsNamespace)&quot; $(_LumioGameplayConfigArgs)" />
    <WriteLinesToFile File="$(_LumioEcsStamp)" Lines="$(_LumioEcsInputHash)" Overwrite="true" Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(_LumioEcsOut)/**/*.cs" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

  <Target Name="ResolveLumioSdk" BeforeTargets="BeforeBuild">
    <Error
      Condition="'$(LumioSdkMode)' == ''"
      Text="LUMIO_SDK_UNRESOLVED: neither a sibling Lumio checkout nor the Lumio.Engine.SDK package was found.%0A%0AChecklist:%0A1. Internal / sibling-dev: set LumioRuntimeRoot to the clone path. The directory must exist. Empty or whitespace values are ignored and are not a silent fallback.%0A2. External: restore Lumio.Engine.SDK $(LumioSdkVersion) from nuget.org (or another public feed). Owner has not published this package yet - package IDs are irreversible, so this tree does not push.%0A3. Local proof: pack with `node eng/pack-sdk.mjs --identity-output identity.json` in LumioGameEngine, then run `node integration/build-local-sdk.mjs identity.json` with that sidecar. Direct folder-feed builds must also set LumioSdkVersion to its exact version.%0A4. There is no placeholder implementation and no silent fallback. Fix one of the three paths above." />
  </Target>
</Project>
