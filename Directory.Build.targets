<Project>
  <!-- Resolve the engine through exactly one of the supported public paths. -->
  <PropertyGroup>
    <_LumioRuntimeRootRaw Condition="'$(LumioRuntimeRoot)' != ''">$(LumioRuntimeRoot.Trim())</_LumioRuntimeRootRaw>
    <_LumioServerRootRaw Condition="'$(LumioServerRoot)' != ''">$(LumioServerRoot.Trim())</_LumioServerRootRaw>
    <_LumioEngineRootRaw Condition="'$(LumioEngineRoot)' != ''">$(LumioEngineRoot.Trim())</_LumioEngineRootRaw>
    <_LumioRuntimeRoot Condition="'$(_LumioRuntimeRootRaw)' != ''">$([System.IO.Path]::GetFullPath('$(_LumioRuntimeRootRaw)'))</_LumioRuntimeRoot>
    <_LumioServerRoot Condition="'$(_LumioServerRootRaw)' != ''">$([System.IO.Path]::GetFullPath('$(_LumioServerRootRaw)'))</_LumioServerRoot>
    <_LumioEngineRoot Condition="'$(_LumioEngineRootRaw)' != ''">$([System.IO.Path]::GetFullPath('$(_LumioEngineRootRaw)'))</_LumioEngineRoot>
    <_LumioLocalFeedRaw Condition="'$(LumioLocalFeed)' != ''">$(LumioLocalFeed.Trim())</_LumioLocalFeedRaw>
    <_LumioLocalFeed Condition="'$(_LumioLocalFeedRaw)' != ''">$([System.IO.Path]::GetFullPath('$(_LumioLocalFeedRaw)'))</_LumioLocalFeed>
    <_LumioRuntimeEcsProject>$(_LumioRuntimeRoot)/modules/ecs/src/Lumio.GameRuntime.Ecs/Lumio.GameRuntime.Ecs.csproj</_LumioRuntimeEcsProject>
    <_LumioRuntimeReplicationProject>$(_LumioRuntimeRoot)/modules/replication/src/Lumio.GameRuntime.Replication/Lumio.GameRuntime.Replication.csproj</_LumioRuntimeReplicationProject>
    <_LumioRuntimeExists Condition="'$(_LumioRuntimeRoot)' != '' and Exists('$(_LumioRuntimeRoot)') and Exists('$(_LumioRuntimeEcsProject)') and Exists('$(_LumioRuntimeReplicationProject)')">true</_LumioRuntimeExists>
    <_LumioRuntimeInvalid Condition="'$(_LumioRuntimeRoot)' != '' and '$(_LumioRuntimeExists)' != 'true'">true</_LumioRuntimeInvalid>
    <_LumioNugetPackages Condition="'$(NuGetPackageRoot)' != ''">$(NuGetPackageRoot)</_LumioNugetPackages>
    <_LumioNugetPackages Condition="'$(_LumioNugetPackages)' == '' and '$(NUGET_PACKAGES)' != ''">$(NUGET_PACKAGES)</_LumioNugetPackages>
    <_LumioNugetPackages Condition="'$(_LumioNugetPackages)' == '' and '$(USERPROFILE)' != ''">$(USERPROFILE)/.nuget/packages</_LumioNugetPackages>
    <_LumioNugetPackages Condition="'$(_LumioNugetPackages)' == '' and '$(HOME)' != ''">$(HOME)/.nuget/packages</_LumioNugetPackages>
    <_LumioNupkg Condition="'$(_LumioLocalFeed)' != '' and Exists('$(_LumioLocalFeed)/Lumio.Engine.SDK.0.1.0.nupkg')">true</_LumioNupkg>
    <_LumioNupkg Condition="'$(_LumioNupkg)' != 'true' and '$(_LumioLocalFeed)' != '' and Exists('$(_LumioLocalFeed)/lumio.engine.sdk.0.1.0.nupkg')">true</_LumioNupkg>
    <_LumioGlobalPackage Condition="'$(_LumioNugetPackages)' != '' and Exists('$(_LumioNugetPackages)/lumio.engine.sdk/0.1.0/lumio.engine.sdk.nuspec')">true</_LumioGlobalPackage>
    <LumioSdkMode Condition="'$(_LumioRuntimeExists)' == 'true'">sibling</LumioSdkMode>
    <LumioSdkMode Condition="'$(LumioSdkMode)' == '' and '$(_LumioRuntimeInvalid)' != 'true' and ('$(_LumioNupkg)' == 'true' or '$(_LumioGlobalPackage)' == 'true')">nuget</LumioSdkMode>
  </PropertyGroup>

  <ItemGroup Condition="'$(LumioSdkMode)' == 'sibling' and '$(MSBuildProjectName)' == 'Lumio.Sample.Gameplay'">
    <ProjectReference Include="$(_LumioRuntimeEcsProject)" />
    <ProjectReference Include="$(_LumioRuntimeReplicationProject)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(LumioSdkMode)' == 'nuget' and '$(_LumioNupkg)' == 'true'">
    <RestoreAdditionalProjectSources>$(_LumioLocalFeed);$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(LumioSdkMode)' == 'nuget' and '$(MSBuildProjectName)' == 'Lumio.Sample.Gameplay'">
    <PackageReference Include="Lumio.Engine.SDK" />
  </ItemGroup>

  <Target Name="ResolveLumioSdk" BeforeTargets="BeforeBuild">
    <Error
      Condition="'$(LumioSdkMode)' == ''"
      Text="LUMIO_SDK_UNRESOLVED: neither a sibling Lumio checkout nor the Lumio.Engine.SDK package was found.%0A%0AChecklist:%0A1. Internal / sibling-dev: set LumioRuntimeRoot (and LumioServerRoot, LumioEngineRoot) to the clone paths. The directories must exist. Empty or whitespace values are ignored and are not a silent fallback.%0A2. External: restore Lumio.Engine.SDK 0.1.0 from nuget.org (or another public feed). Owner has not published this package yet - package IDs are irreversible, so this tree does not push.%0A3. Local proof: pack with `node eng/pack-sdk.mjs` in LumioGameEngine and add a folder-feed (NuGet.config source or LumioLocalFeed) pointing at the nupkg directory.%0A4. There is no placeholder implementation and no silent fallback. Fix one of the three paths above." />
  </Target>
</Project>
